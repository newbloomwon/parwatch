# ── ParWatch agent keys ───────────────────────────────────────────────
# Copy this file to `.env` and fill in what you have. Any integration whose
# keys are blank runs in MOCK mode, so the agent still runs end-to-end.

# ── SurrealDB Agent Memory (REST) — the agent's long-term memory ──────
# From SurrealDB Studio → your context → API Keys view:
#   ENDPOINT = the context host shown there (looks like https://<id>.<region>.surreal.cloud)
#   CONTEXT  = the context id (the long id in the Studio URL, after /contexts/)
#   KEY      = the key you copied ("Copy your API key now")
SURREAL_MEM_ENDPOINT=
SURREAL_MEM_CONTEXT=
SURREAL_MEM_KEY=

# ── Anchor Browser — the agent's hands ───────────────────────────────
# ANCHOR_API_KEY: the "Default API Key" (sk-...) from Anchor → API Keys.
# SUPPLIER_URL: public URL where you host mock-supplier.html (blank = local mock).
ANCHOR_API_KEY=
ANCHOR_CDP_URL=
SUPPLIER_URL=

# ── Arize Phoenix — observability ────────────────────────────────────
# PHOENIX_API_KEY: the System API Key from Phoenix → Settings → API Keys.
# PHOENIX_COLLECTOR_ENDPOINT: https://app.phoenix.arize.com
PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com
PHOENIX_API_KEY=

# ── ElevenLabs — voice ───────────────────────────────────────────────
# ELEVENLABS_API_KEY: from ElevenLabs → Settings → API Keys (not "Profile").
# ELEVENLABS_VOICE_ID: a default public voice; change in Voices if you like.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# ── Optional LLM (not needed — decision is rule-based) ────────────────
ANTHROPIC_API_KEY=
